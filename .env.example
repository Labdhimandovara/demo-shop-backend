# Supabase Project Details
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PROJECT_NAME="website-demo-shop"
SUPABASE_REGION="ap-south-1"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Connection URLs for Prisma & Backend
DIRECT_URL="postgresql://postgres:PASSWORD@db.your-project-id.supabase.co:5432/postgres"
DATABASE_URL="postgresql://postgres.your-project-id:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Authentication & Security
JWT_SECRET="your-32-byte-hex-secret"
JWT_EXPIRES_IN="7d"

# CORS Configuration
ALLOWED_ORIGINS="http://localhost:3000,https://your-domain.vercel.app"
