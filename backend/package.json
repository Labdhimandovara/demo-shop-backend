{
  "name": "demo-shop-backend",
  "version": "1.0.0",
  "description": "Demo shopping REST API with JWT auth and Supabase",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:push": "./node_modules/.bin/prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:studio": "./node_modules/.bin/prisma studio",
    "db:generate": "./node_modules/.bin/prisma generate",
    "postinstall": "./node_modules/.bin/prisma generate || true"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^5.22.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true
  }
}
